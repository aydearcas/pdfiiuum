{
  "manifest_version": 3,
  "name": "pdfiiuum",
  "description": "Abre los PDF en el visor de pdfiiuum dentro del navegador (con anotaciones, lápiz y edición) o en la app de escritorio.",
  "version": "0.4.3",
  "key": "",
  "minimum_chrome_version": "128",
  "permissions": ["nativeMessaging", "contextMenus", "declarativeNetRequestWithHostAccess", "storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "pdfiiuum",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["viewer/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
